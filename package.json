
{
  "name": "codex-quota-bar",
  "displayName": "Codex Quota Bar",
  "description": "A VS Code status-bar extension for monitoring Codex token quotas.",
  "publisher": "local",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshuadendy/codex-token-quota.git"
  },
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "Codex Quota Bar",
      "properties": {
        "codexQuota.executablePath": {
          "type": "string",
          "default": "/opt/homebrew/bin/codex",
          "description": "Absolute path to the Codex CLI executable."
        }
      }
    },
    "commands": [
      {
        "command": "codexQuota.refresh",
        "title": "Codex Quota: Refresh"
      }
    ]
  }
}
